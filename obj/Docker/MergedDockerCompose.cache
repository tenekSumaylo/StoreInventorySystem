name: dockercompose15198631374442501896
services:
  inventory_backend:
    build:
      context: D:\Programming Repository\StoreInventorySystem
      dockerfile: inventory_backend/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
    image: inventorybackend
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\kenne\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\kenne\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose15198631374442501896_default